{
  "name": "weddings-aniceta-kerusso",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weddings-aniceta-kerusso-db",
      "database_id": "079b072d-9648-49d9-9730-f12af6f3cc1a"
    }
  ]
}
